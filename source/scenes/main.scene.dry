title: 下个月
set-bg: img/map_2.jpg
is-hand: true
on-arrival: {!
if (Q.advisor_action_timer <= 0) {
    Q.pinnedCardsDescription = '顾问 — 有可用行动。';
} else if (Q.advisor_action_timer == 1) {
    Q.pinnedCardsDescription = '顾问 — 下次行动将在 1 个月后可用。';
} else {
    Q.pinnedCardsDescription = '顾问 — 下次行动将在 ' + Q.advisor_action_timer + ' 个月后可用。';
}
!}
max-cards: 3

#此处显示主牌库。点击牌库会抽一张牌到手牌。点击卡牌即打出该牌。

[? if year = 1928 and month = 2 : 现任资产阶级右翼政府已倒台。下届选举定于今年五月举行。 ?]

- @party
- @govt
- @pres
- #advisor
- @shuffle_leadership_pinned
- @megatome

