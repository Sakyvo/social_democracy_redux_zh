title: 概况
new-page: true
is-special: true
on-arrival: {!
if (Q.unemployed) {
    Q.unemployed_2 = Q.unemployed.toFixed(1);
}
if (Q.inflation) {
    Q.inflation_2 = Q.inflation.toFixed(1);
}
Q.economic_growth_2 = '0';
if (Q.economic_growth) {
    Q.economic_growth_2 = Q.economic_growth.toFixed(1);
}
!}

= 概况

[+ month : month +] [+ year +]

可用资源: [+ resources +]

社民党地位: [? if spd_toleration : 容忍 ?][? if spd_in_government : 执政 — ?][? if spd_toleration == 0 and spd_in_government == 0 and spd_caretaker == 0 : 在野 ?][? if spd_caretaker : 看守政府 ?]
[? if in_weimar_coalition and spd_in_government: 魏玛联盟 ?][? if in_grand_coalition and spd_in_government: 大联合政府 ?][? if in_popular_front and spd_in_government: 人民阵线 ?][? if in_left_front and spd_in_government: 左翼阵线 ?][? if in_spd_majority and spd_in_government: 社民党多数政府 ?][? if in_minority_government and spd_in_government: 少数派政府 ?][? if in_emergency_government and spd_in_government: 紧急政府 ?]

[? if spd_in_government and not in_spd_majority and not in_left_front : 执政联盟内异议: [+ coalition_dissent : coalition_dissent +] ?]

[? if spd_in_government and (in_left_front or in_popular_front): 共产党内部异议: [+ kpd_coalition_dissent : coalition_dissent +] ?]

党内异议: [+ dissent_percent : dissent +]

[? if communist_influence_seen : 共产党的影响力: [+ kpd_influence : kpd_influence +] ?]

= 政府

总统: [+ president +]

[? if president == "Marx" : 与总统的关系: [+ marx_relation : relationships +] ?]

总理: [+ chancellor +] ([+ chancellor_party +])

[? if policy_seen and gov_tension : 政府内部紧张: [+ gov_tension : coalition_dissent +] ?]

国会席位:

# 1928: 30, 1930: 25, 1932: 22
社民党: [+ spd_r +]%
[? if sapd_formed == 1 : 社会主义工人党: [+ sapd_r +]% ?]
# 1928: 15, 1930: 15, 1932: 
中央党 + 巴伐利亚人民党: [+ z_r +]%
# 1928: 10, 1930: 13
共产党: [+ kpd_r +]%
# 1928: 5, 1930: 4 (as DstP)
民主党: [+ ddp_r +]%
# 1928: 9, 1930: 5
人民党: [+ dvp_r +]%
# 1928: 14, 1930: 7
国家人民党: [+ dnvp_r +]%
# 1928: 3, 1930: 18
纳粹党: [+ nsdap_r +]%
# 1928: 9, 1930: 10
其他: [+ other_r +]%

[? if spd_in_government = 1 : 财政预算: [+ budget +] ?]

下次选举: [+ next_election_month : month +] [+ next_election_year +]

= 经济

通货膨胀: [+ inflation_2 +]%

[? if black_thursday_seen = 1 : 失业率: [+ unemployed_2 +]% ?]

经济增长: [+ economic_growth_2 +]%

[? if investigate_corruption : 资本的影响力: [+ assessed_bourgeois : bourgeois_power +] [? if inaccuracy : — 数据不准确 ?] ?]

# = 民意

@politics

= 党际关系


中央党: [+ z_relation : relationships +]

民主党: [+ ddp_relation : relationships +]

人民党: [+ dvp_relation : relationships +]

共产党: [+ kpd_relation : relationships +]

国家人民党: [+ dnvp_relation : relationships +]

纳粹党: [+ nsdap_relation : relationships +]

= 社民党内部派系

左翼力量: [+ left_strength : strength +],异议: [+ left_dissent : dissent +]

中间派力量: [+ center_strength : strength +],异议: [+ center_dissent : dissent +]

工会力量: [+ labor_strength : strength +],异议: [+ labor_dissent : dissent +]

改良派力量: [+ reformist_strength : strength +],异议: [+ reformist_dissent : dissent +]

[? if neorevisionism > 0 : 新修正主义派力量: [+ neorevisionist_strength : strength +],异议: [+ neorevisionist_dissent : dissent +] ?]


@paramilitaries
on-arrival: {!
if (Q.rb_strength) {
    Q.rb_strength_2 = Q.rb_strength.toFixed(1);
}
if (Q.rfb_strength) {
    Q.rfb_strength_2 = Q.rfb_strength.toFixed(1);
}
if (Q.sh_strength) {
    Q.sh_strength_2 = Q.sh_strength.toFixed(1);
}
if (Q.sa_strength) {
    Q.sa_strength_2 = Q.sa_strength.toFixed(1);
}
!}

= 力量分布

冲锋队: [+ sa_force +]%

钢盔团: [+ sh_force +]%

国旗团: [+ rb_force +]%

红色前线: [+ rfb_force +]%

普鲁士: [+ prussia_force +]%

国防军: [+ army_force +]%

= 准军事组织

国旗团兵力: [+ rb_strength_2 +] 千人

国旗团军事化程度: [+ rb_militancy : militancy +]

红色前线兵力: [+ rfb_strength_2 +] 千人

红色前线军事化程度: [+ rfb_militancy : militancy +]

钢盔团兵力: [+ sh_strength_2 +] 千人

钢盔团军事化程度: [+ sh_militancy : militancy +]

冲锋队兵力: [+ sa_strength_2 +] 千人

冲锋队军事化程度: [+ sa_militancy : militancy +]

= 官方军事 / 准军事力量

国防军: [+ reichswehr_strength +] 千人。

国防军忠诚度: [+ reichswehr_loyalty : loyalty +]

普鲁士警察: [+ prussian_police_strength +] 千人。

普鲁士警察忠诚度: [+ prussian_police_loyalty : loyalty +]

[? if spd_in_government : 内政部警察忠诚度: [+ interior_police_loyalty : loyalty +] ?]

@polls
on-arrival: {!
Q.pro_republic_disp = Math.round(Q.pro_republic);
Q.nationalism_disp = Math.round(Q.nationalism);
Q.socialism_disp = Math.round(Q.socialism);
!}

