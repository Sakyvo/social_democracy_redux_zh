{!<tr><td><div class="box" style='background-color:#a0a0a0'> </div></td><td>!} 其他政党: {!</td><td>!} [+ other_r +] % {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#3f7bc1'> </div></td><td>!} 国家人民党: {!</td><td>!} [+ dnvp_r +]% {!</td></tr>!}

