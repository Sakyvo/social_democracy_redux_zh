title: 中央党基督教联盟
subtitle: 资产阶级联合成一个新政党。
view-if: month == 3 and not z_banned and ((bourgeois_power - (socialism/100)) < 0.5) and spd_in_government and not in_grand_coalition and not in_weimar_coalition and ((capital_strike_seen and financing_banned and capital_strike_progress >= (z_relation/2) and (nsdap_banned or capital_nazi)) or (victory_republic and ((capital_strike_progress >= (z_relation/4) and left_strength >= reformist_strength and not kpd_banned) or dvp_banned))) and z_relation < 50 and ddp_relation < 50 and dvp_relation < 50
max-visits: 1
tags: event
new-page: true
on-arrival: {! 

Q.parties.push('zca');
Q.zca_formed = 1;

Q.workers_zca = (Q.workers_z+Q.workers_ddp+Q.workers_dvp);
Q.new_middle_zca = (Q.new_middle_z+Q.new_middle_ddp+Q.new_middle_dvp);
Q.old_middle_zca = (Q.old_middle_z+Q.old_middle_ddp+Q.old_middle_dvp);
Q.rural_zca = (Q.rural_z+Q.rural_ddp+Q.rural_dvp);
Q.unemployed_zca = (Q.unemployed_z+Q.unemployed_ddp+Q.unemployed_dvp);
Q.catholics_zca = (Q.catholics_z*0.95);
Q.bourgeoisie_zca = (Q.bourgeoisie_z+Q.bourgeoisie_ddp+Q.bourgeoisie_dvp);

Q.catholics_z *= 0.05;
Q.workers_z = 0;
Q.new_middle_z = 0;
Q.old_middle_z = 0;
Q.rural_z = 0;
Q.unemployed_z = 0;

Q.workers_ddp = 0;
Q.new_middle_ddp = 0;
Q.old_middle_ddp = 0;
Q.rural_ddp = 0;
Q.unemployed_ddp = 0;
Q.catholics_ddp = 0;

Q.workers_dvp = 0;
Q.new_middle_dvp = 0;
Q.old_middle_dvp = 0;
Q.rural_dvp = 0;
Q.unemployed_dvp = 0;
Q.catholics_dvp = 0;

Q.new_middle_spd *= (1-((Q.socialism/100)*0.25));
Q.old_middle_spd *= (1-((Q.socialism/100)*0.25));
Q.rural_spd *= (1-((Q.socialism/100)*0.25));
Q.catholics_spd *= (1-((Q.socialism/100)*0.25));
Q.unemployed_spd *= (1-((Q.socialism/100)*0.1));
Q.workers_spd *= (1-((Q.socialism/100)*0.1));

if (Q.capital_strike_progress < 20) {
    Q.socialism -= (Q.capital_strike_progress*Q.bourgeois_power);
}
if (Q.capital_strike_progress >= 20) {
    Q.socialism -= (20*Q.bourgeois_power);
}
Q.coup_progress += (Q.capital_strike_progress*Q.bourgeois_power*(Q.spd_normalized+Q.kpd_normalized));

if (!Q.socialized_media) {
    Q.workers_zca += (Q.capital_strike_progress*Q.bourgeois_power*(1-(Q.socialism/100)))*3;
    Q.new_middle_zca += (Q.capital_strike_progress*Q.bourgeois_power)*3;
    Q.old_middle_zca += (Q.capital_strike_progress*Q.bourgeois_power)*3;
    Q.rural_zca += (Q.capital_strike_progress*Q.bourgeois_power)*3;
    Q.bourgeoisie_zca += (3*Q.capital_strike_progress);
}
if (Q.socialized_media) {
    Q.workers_zca += (Q.capital_strike_progress*Q.bourgeois_power*(1-(Q.socialism/100)))*1.5;
    Q.new_middle_zca += (Q.capital_strike_progress*Q.bourgeois_power)*1.5;
    Q.old_middle_zca += (Q.capital_strike_progress*Q.bourgeois_power)*1.5;
    Q.rural_zca += (Q.capital_strike_progress*Q.bourgeois_power)*1.5;
    Q.bourgeoisie_zca += (3*Q.capital_strike_progress);
}

Q.zca_r = 0;
Q.old_z_r = 0;
for (var record of Q.election_records) {
    record['zca'] = 0;
}
for (var record of Q.party_support_records) {
    record['zca'] = 0;
}

Q.workers_zca += Q.workers_other;
Q.new_middle_zca += Q.new_middle_other;
Q.old_middle_zca += Q.old_middle_other;
Q.rural_zca += Q.rural_other;
Q.unemployed_zca += Q.unemployed_other;
Q.catholics_zca += Q.catholics_other;

Q.workers_other *= (1-(Q.socialism/100));
Q.new_middle_other *= (1-(Q.socialism/100));
Q.old_middle_other *= (1-(Q.socialism/100));
Q.rural_other *= (1-(Q.socialism/100));
Q.unemployed_other *= (1-(Q.socialism/100));
Q.catholics_other *= (1-(Q.socialism/100));

Q.workers_zca -= Q.workers_other;
Q.new_middle_zca -= Q.new_middle_other;
Q.old_middle_zca -= Q.old_middle_other;
Q.rural_zca -= Q.rural_other;
Q.unemployed_zca -= Q.unemployed_other;
Q.catholics_zca -= Q.catholics_other;

if (Q.sh_force+Q.sa_force < Q.rb_force+Q.rfb_force) {
    Q.workers_zca *= (1-(((Q.rb_force*(Q.left_strength/100)+Q.rfb_force)/100)*0.05));
    Q.new_middle_zca *= (1-(((Q.rb_force*(Q.left_strength/100)+Q.rfb_force)/100)*0.05));
    Q.old_middle_zca *= (1-(((Q.rb_force*(Q.left_strength/100)+Q.rfb_force)/100)*0.05));
    Q.rural_zca *= (1-(((Q.rb_force*(Q.left_strength/100)+Q.rfb_force)/100)*0.05));
    Q.unemployed_zca *= (1-(((Q.rb_force*(Q.left_strength/100)+Q.rfb_force)/100)*0.05));
    Q.catholics_zca *= (1-(((Q.rb_force*(Q.left_strength/100)+Q.rfb_force)/100)*0.05));
}

!}

= 中央党基督教联盟

在资产阶级对德国的掌控前所未有地薄弱、德国似乎正滑向社会主义之际,一个新政党宣告成立:中央党基督教联盟,意在把天主教徒与自由派合并为一个代表资产阶级利益的单一政党。他们推举奥托·格斯勒为领袖,打算反对我们的社会主义议程 —— 尽管他们并不显得公然反民主。[? if nsdap_banned : 不过,有人担心纳粹会把他们当作特洛伊木马。 ?]

[? if capital_strike_seen : 显然,他们体现的是那个曾对我们发动罢工的工商界的利益。 ?][? if victory_republic : 他们的成立必定会为正在成形的战后政治增添波澜。 ?]

尽管这场合并已获各组成政党多数的批准,各党仍各自留下了一些小碎片,由反对的少数派构成。