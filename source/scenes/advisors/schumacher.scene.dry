@build_reichsbanner
title: 国旗团
subtitle: 舒马赫支持向国旗团提供更多资源。
choose-if: advisor_action_timer = 0
unavailable-subtitle: [? if advisor_action_timer > 0 : 距下次顾问行动还有 [+ advisor_action_timer +] 个月。 ?]
on-arrival: advisor_action_timer = 6; reichsbanner_timer -= 6; last_advisor_action = 1
go-to: reichsbanner

@moderate_economic_plan
title: 支持改良派经济计划
subtitle: 呼吁推行一项有限的、不依赖赤字支出的创造就业计划。
choose-if: advisor_action_timer = 0 and moderate_plan_adopted = 0 and black_thursday_seen = 1
unavailable-subtitle: [? if advisor_action_timer > 0 : 距下次顾问行动还有 [+ advisor_action_timer +] 个月。 ?] [? if moderate_economic_plan = 0 : 我们已经采纳了改良派经济计划。 ?] [? if black_thursday_seen == 0 : 我们目前并未处于经济危机之中。 ?]
on-arrival: advisor_action_timer = 6
go-to: crisis_program.support_moderate

